(in-package #:loom/test)

(describe "WP5a basic editing"
  (it "keeps command word boundaries equal to word motion for mixed text"
    (dolist (text (list "" "word_123 next" "foo-bar!? 42" "ＡＢ１２_日本語 xyz"
                       (format nil "a_b~C  Ｚ9!~%end" #\Tab)))
      (loop for offset from 0 to (length text)
            do (expect (loom/core/command::%command-forward-word-offset text offset)
                       :to-equal (loom::%forward-word-offset text offset))
               (expect (loom/core/command::%command-backward-word-offset text offset)
                       :to-equal (loom::%backward-word-offset text offset)))))
  (it "moves to indentation with every prefix and permits read-only buffers"
    (dolist (prefix '(nil 2 -2 0))
      (dolist (case (list (list "" 0 0)
                         (list (format nil " ~Cfoo" #\Tab) 4 2)
                         (list "   " 1 3)
                         (list (format nil "one~%  two") 7 6)))
        (%with-selected-buffer-state (buffer (first case))
          (loom/core/buffer:buffer-set-point-offset buffer (second case))
          (loom/core/buffer:buffer-set-read-only buffer t)
          (let ((loom/core/command:*current-prefix-argument* prefix))
            (loom/core/command::back-to-indentation))
          (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (third case))
          (expect (buffer-text buffer) :to-equal (first case))))))
  (it "deletes both horizontal sides without prefix and only before with any prefix"
    (dolist (prefix '(nil 2 -2 0))
      (%with-selected-buffer-state (buffer (format nil "a ~C  b" #\Tab))
        (loom/core/buffer:buffer-set-point-offset buffer 3)
        (let ((loom/core/command:*current-prefix-argument* prefix))
          (loom/core/command::delete-horizontal-space))
        (expect (buffer-text buffer) :to-equal (if prefix "a  b" "ab"))
        (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal 1)
        (loom/core/buffer:buffer-undo buffer)
        (expect (buffer-text buffer) :to-equal (format nil "a ~C  b" #\Tab))))
    (dolist (case (list (list "" 0 "") (list "   " 0 "")
                       (list "   " 3 "")
                       (list (format nil "a~%  b") 2 (format nil "a~%b"))
                       (list (format nil "a  ~%b") 3 (format nil "a~%b"))))
      (%with-selected-buffer-state (buffer (first case))
        (loom/core/buffer:buffer-set-point-offset buffer (second case))
        (loom/core/command::delete-horizontal-space)
        (expect (buffer-text buffer) :to-equal (third case)))))
  (it "normalizes spaces for positive, zero, negative, and absent prefixes"
    (dolist (case (list (list nil "a b" 2)
                       (list 2 "a  b" 3)
                       (list 0 "ab" 1)
                       (list -2 "a  b" 3)))
      (%with-selected-buffer-state (buffer (format nil "a ~C  b" #\Tab))
        (loom/core/buffer:buffer-set-point-offset buffer 3)
        (let ((loom/core/command:*current-prefix-argument* (first case)))
          (loom/core/command::just-one-space))
        (expect (buffer-text buffer) :to-equal (second case))
        (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (third case))
        (loom/core/buffer:buffer-undo buffer)
        (expect (buffer-text buffer) :to-equal (format nil "a ~C  b" #\Tab))))
    (dolist (case (list (list "" 0 " " 1)
                       (list "   " 0 " " 1)
                       (list "   " 3 " " 1)
                       (list "abc" 3 "abc " 4)))
      (%with-selected-buffer-state (buffer (first case))
        (loom/core/buffer:buffer-set-point-offset buffer (second case))
        (loom/core/command::just-one-space)
        (expect (buffer-text buffer) :to-equal (third case))
        (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (fourth case)))))
  (it "crosses newlines only for a negative spacing prefix"
    (dolist (case (list (list nil (format nil "a ~C~% b" #\Tab) 5)
                       (list 2 (format nil "a ~C~%  b" #\Tab) 6)
                       (list 0 (format nil "a ~C~%b" #\Tab) 4)
                       (list -2 "a  b" 3)))
      (%with-selected-buffer-state (buffer (format nil "a ~C~% ~C b" #\Tab #\Tab))
        (loom/core/buffer:buffer-set-point-offset buffer 4)
        (let ((loom/core/command:*current-prefix-argument* (first case)))
          (loom/core/command::just-one-space))
        (expect (buffer-text buffer) :to-equal (second case))
        (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (third case)))))
  (it "transposes the preceding or containing word across positive or negative blocks"
    (dolist (case '((0 nil "two one three four" 7)
                   (1 nil "two one three four" 7)
                   (3 nil "two one three four" 7)
                   (4 nil "two one three four" 7)
                   (5 nil "one three two four" 13)
                   (4 2 "two three one four" 13)
                   (10 -1 "one three two four" 9)
                   (10 -2 "three one two four" 5)))
      (%with-selected-minibuffer-buffer (minibuffer buffer "one two three four")
        (loom/core/buffer:buffer-set-point-offset buffer (first case))
        (let ((loom/core/command:*current-prefix-argument* (second case)))
          (loom/core/command::transpose-words))
        (expect (buffer-text buffer) :to-equal (third case))
        (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (fourth case))
        (loom/core/buffer:buffer-undo buffer)
        (expect (buffer-text buffer) :to-equal "one two three four")
        (expect (loom/core/minibuffer:minibuffer-message-string minibuffer) :to-be nil))))
  (it "exchanges point and mark words for a zero transpose prefix"
    (dolist (case '((4 0 "two one three four" 0 4)
                   (5 1 "two one three four" 0 7)
                   (0 8 "three two one four" 10 0)
                   (2 10 "three two one four" 13 0)))
      (%with-selected-minibuffer-buffer (minibuffer buffer "one two three four")
        (declare (ignore minibuffer))
        (loom/core/buffer:buffer-set-point-offset buffer (first case))
        (loom/core/buffer:buffer-set-mark buffer 0 (second case))
        (let ((loom/core/command:*current-prefix-argument* 0))
          (loom/core/command::transpose-words))
        (expect (buffer-text buffer) :to-equal (third case))
        (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (fourth case))
        (multiple-value-bind (line column) (loom/core/buffer:buffer-mark buffer)
          (expect (cons line column) :to-equal (cons 0 (fifth case)))))))
  (it "rejects missing or overlapping words without modifying text, point, or history"
  (dolist (case '(("" 0 nil) ("one" 0 nil) (" one " 0 nil)
                 ("one two" 7 nil) ("one two three" 4 -2)
                 ("one two three" 4 4) ("one two" 1 0)))
    (%with-selected-minibuffer-buffer (minibuffer buffer (first case))
      (declare (ignore minibuffer))
      (loom/core/buffer:buffer-set-point-offset buffer (length (first case)))
      (loom/core/buffer:buffer-insert-string buffer "!")
      (loom/core/buffer:buffer-set-point-offset buffer (second case))
      (when (eql (third case) 0) (loom/core/buffer:buffer-set-mark buffer 0 0))
      (let* ((loom/core/command:*current-prefix-argument* (third case))
             (condition (handler-case (loom/core/command::transpose-words)
                          (error (condition) condition))))
        (expect (typep condition 'error) :to-be-truthy)
        (expect (and condition (princ-to-string condition))
                :to-equal "Don't have two things to transpose"))
      (expect (buffer-text buffer) :to-equal (concatenate 'string (first case) "!"))
      (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal (second case))
      (loom/core/buffer:buffer-undo buffer)
      (expect (buffer-text buffer) :to-equal (first case)))))
  (it "rejects every mutator on read-only buffers including no-op inputs"
    (dolist (command '(loom/core/command::delete-horizontal-space
                       loom/core/command::just-one-space
                       loom/core/command::transpose-words))
      (dolist (text '("" "one two" "a  b"))
        (%with-selected-minibuffer-buffer (minibuffer buffer text)
          (declare (ignore minibuffer))
          (loom/core/buffer:buffer-set-read-only buffer t)
          (signals loom/core/buffer:buffer-read-only-error (funcall command))
          (expect (buffer-text buffer) :to-equal text)))))
  (it "keeps horizontal edits and word transposition inside a narrowed midline"
    (dolist (case '((loom/core/command::delete-horizontal-space "pre a  b post" 5 1 8 "pre ab post")
                   (loom/core/command::just-one-space "pre a  b post" 5 1 8 "pre a b post")
                   (loom/core/command::transpose-words "pre one two post" 8 4 11 "pre two one post")))
      (%with-selected-minibuffer-buffer (minibuffer buffer (second case))
        (declare (ignore minibuffer))
        (loom/core/buffer:buffer-narrow-to-region buffer 0 (fourth case) 0 (fifth case))
        (loom/core/buffer:buffer-set-point-offset buffer (third case))
        (funcall (first case))
        (loom/core/buffer:buffer-widen buffer)
        (expect (buffer-text buffer) :to-equal (sixth case)))))
  (it "counts visible buffer characters and words using the shared word predicate"
    (dolist (case (list (list "" "Buffer has 0 lines, 0 words, and 0 characters.")
                       (list "one_two foo-bar 123" "Buffer has 1 lines, 4 words, and 19 characters.")
                       (list (format nil "one~%two") "Buffer has 2 lines, 2 words, and 7 characters.")
                       (list (format nil "one~%two~%") "Buffer has 2 lines, 2 words, and 8 characters.")))
      (%with-selected-minibuffer-buffer (minibuffer buffer (first case))
        (loom/core/buffer:buffer-set-read-only buffer t)
        (loom/core/command::count-words-region)
        (expect (loom/core/minibuffer:minibuffer-message-string minibuffer) :to-equal (second case))
        (expect (buffer-text buffer) :to-equal (first case)))))
  (it "counts active regions in either direction and ignores an inactive mark"
    (dolist (reverse-p '(nil t))
      (%with-selected-minibuffer-buffer (minibuffer buffer (format nil "one~%two~%"))
        (loom/core/buffer:buffer-set-point buffer (if reverse-p 1 0) 1)
        (loom/core/buffer:buffer-set-mark buffer (if reverse-p 0 1) 1)
        (loom/core/command::count-words-region)
        (expect (loom/core/minibuffer:minibuffer-message-string minibuffer)
                :to-equal "Region has 2 lines, 2 words, and 4 characters.")
        (loom/core/buffer:buffer-deactivate-mark buffer)
        (loom/core/command::count-words-region)
        (expect (loom/core/minibuffer:minibuffer-message-string minibuffer)
                :to-equal "Buffer has 2 lines, 2 words, and 8 characters."))))
  (it "isolates each mutator from a preceding insertion in undo history"
    (dolist (case (list
                  (list 'loom/core/command::delete-horizontal-space "a  b" 2 nil nil "ab!")
                  (list 'loom/core/command::just-one-space "a  b" 2 nil nil "a b!")
                  (list 'loom/core/command::just-one-space
                        (format nil "a ~C~% ~C b" #\Tab #\Tab) 4 -2 nil "a  b!")
                  (list 'loom/core/command::transpose-words "one two three" 4 nil nil "two one three!")
                  (list 'loom/core/command::transpose-words "one two three" 4 0 0 "two one three!")))
      (%with-selected-minibuffer-buffer (minibuffer buffer (second case))
        (declare (ignore minibuffer))
        (loom/core/buffer:buffer-set-point-offset buffer (length (second case)))
        (loom/core/buffer:buffer-insert-string buffer "!")
        (loom/core/buffer:buffer-set-point-offset buffer (third case))
        (when (fifth case) (loom/core/buffer:buffer-set-mark buffer 0 (fifth case)))
        (let ((loom/core/command:*current-prefix-argument* (fourth case)))
          (funcall (first case)))
        (expect (buffer-text buffer) :to-equal (sixth case))
        (loom/core/buffer:buffer-undo buffer)
        (expect (buffer-text buffer) :to-equal (concatenate 'string (second case) "!"))
        (loom/core/buffer:buffer-undo buffer :continue-p t)
        (expect (buffer-text buffer) :to-equal (second case)))))
  (it "clips whitespace runs at both narrowing edges and excludes outside words"
    (dolist (case (list
                  (list 'loom/core/command::delete-horizontal-space "aa    bb" 3 5 4 nil "aa  bb")
                  (list 'loom/core/command::just-one-space "aa    bb" 3 5 4 nil "aa   bb")
                  (list 'loom/core/command::just-one-space
                        (format nil "aa ~% ~% bb") 3 6 4 -2 "aa    bb")))
      (%with-selected-buffer-state (buffer (second case))
        (let ((start (loom/core/buffer:buffer-offset-position buffer (third case)))
              (end (loom/core/buffer:buffer-offset-position buffer (fourth case))))
          (loom/core/buffer:buffer-narrow-to-region
           buffer (loom/core/buffer:buffer-position-line start)
           (loom/core/buffer:buffer-position-column start)
           (loom/core/buffer:buffer-position-line end)
           (loom/core/buffer:buffer-position-column end)))
        (loom/core/buffer:buffer-set-point-offset buffer (fifth case))
        (let ((loom/core/command:*current-prefix-argument* (sixth case)))
          (funcall (first case)))
        (loom/core/buffer:buffer-widen buffer)
        (expect (buffer-text buffer) :to-equal (seventh case))))
    (%with-selected-minibuffer-buffer (minibuffer buffer "one two")
      (declare (ignore minibuffer))
      (loom/core/buffer:buffer-narrow-to-region buffer 0 4 0 7)
      (loom/core/buffer:buffer-set-point-offset buffer 4)
      (let ((condition (handler-case (loom/core/command::transpose-words)
                         (error (condition) condition))))
        (expect (typep condition 'error) :to-be-truthy)
        (expect (and condition (princ-to-string condition))
                :to-equal "Don't have two things to transpose"))
      (expect (loom/core/buffer:buffer-point-offset buffer) :to-equal 4)
      (loom/core/buffer:buffer-widen buffer)
      (expect (buffer-text buffer) :to-equal "one two")))
  (it "does not record a failed transpose or replay past it"
    (%with-selected-minibuffer-buffer (minibuffer buffer "one")
      (let* ((keymap (loom/application:install-default-keybindings (make-keymap)))
             (keymap-state (make-keymap-state keymap))
             (macro (loom/feature/keyboard-macro:make-keyboard-macro)))
        (setf (editor-state-keymap *editor-state*) keymap
              (loom/core/editor-session:editor-state-keyboard-macro *editor-state*) macro)
        (loom/feature/keyboard-macro:keyboard-macro-start-recording macro)
        (loom::%dispatch-key-event (%prefix-event #\t '(:alt)) keymap-state)
        (expect (loom/feature/keyboard-macro:keyboard-macro-events macro) :to-be nil)
        (expect (loom/core/minibuffer:minibuffer-message-string minibuffer)
                :to-equal "Don't have two things to transpose")
        (expect (buffer-text buffer) :to-equal "one")))
    (%with-selected-minibuffer-buffer (minibuffer buffer "one")
      (declare (ignore minibuffer))
      (let ((keymap (loom/application:install-default-keybindings (make-keymap)))
            (macro (loom/feature/keyboard-macro:make-keyboard-macro)))
        (setf (editor-state-keymap *editor-state*) keymap
              (loom/core/editor-session:editor-state-keyboard-macro *editor-state*) macro)
        (loom/feature/keyboard-macro:keyboard-macro-start-recording macro)
        (loom/feature/keyboard-macro:keyboard-macro-record-event
         macro (loom/feature/keyboard-macro:make-keyboard-macro-event
                :kind :key :value (cons '(:alt) #\t)))
        (loom/feature/keyboard-macro:keyboard-macro-record-event
         macro (loom/feature/keyboard-macro:make-keyboard-macro-event
                :kind :self-insert :value #\X))
        (loom/feature/keyboard-macro:keyboard-macro-stop-recording macro)
        (signals error (loom/feature/keyboard-macro:call-last-kbd-macro))
        (expect (buffer-text buffer) :to-equal "one")
        (expect (loom/feature/keyboard-macro:keyboard-macro-replaying-p macro) :to-be nil))))
  (it "counts only accessible text and handles an empty active region"
    (%with-selected-minibuffer-buffer (minibuffer buffer "outside one_two 42 outside")
      (loom/core/buffer:buffer-narrow-to-region buffer 0 8 0 18)
      (loom/core/command::count-words-region)
      (expect (loom/core/minibuffer:minibuffer-message-string minibuffer)
              :to-equal "Buffer has 1 lines, 2 words, and 10 characters.")
      (loom/core/buffer:buffer-set-mark buffer 0 (buffer-point-column buffer))
      (loom/core/command::count-words-region)
      (expect (loom/core/minibuffer:minibuffer-message-string minibuffer)
              :to-equal "Region has 0 lines, 0 words, and 0 characters."))))
