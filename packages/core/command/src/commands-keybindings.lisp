(in-package #:loom/core/command)

(defun install-default-keybindings (keymap &key (keymap-name :global))
  (dolist (spec (command-specs))
    (when (and (%command-spec-catalog-visible-p spec)
               (eq (%command-spec-keymap spec) keymap-name))
      (dolist (key-sequence (%command-spec-keys spec))
        (keymap-define-key keymap key-sequence (command-spec-id spec)))))
  (when (eq keymap-name :global)
    (dolist (binding (quote ((:page-up "scroll-down-command")
                             (:page-down "scroll-up-command"))))
      (let ((command-id (second binding)))
        (when (%find-command-spec-by-id command-id)
          (keymap-define-key keymap (list (first binding)) command-id)))))
  keymap)
