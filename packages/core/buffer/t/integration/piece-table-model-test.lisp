(in-package #:loom/test)

(defun %model-position-at (text offset)
  (let ((line 0)
        (column 0))
    (loop for index below offset
          do (if (char= (char text index) #\Newline)
                 (progn
                   (incf line)
                   (setf column 0))
                 (incf column)))
    (values line column)))

(defun %model-next-random (state)
  (let ((next (mod (+ (* state 1103515245) 12345)
                   2147483648)))
    (values (ldb (byte 23 8) next) next)))

(defun %model-random-index (state limit)
  (multiple-value-bind (random next-state)
      (%model-next-random state)
    (values (mod random limit) next-state)))

(defun %model-line-count (text)
  (1+ (count #\Newline text)))

(defun %model-apply-insertion (buffer reference state insertions)
  (let ((size (length reference)))
    (multiple-value-bind (offset state)
        (%model-random-index state (1+ size))
      (multiple-value-bind (insertion-index state)
          (%model-random-index state (length insertions))
        (let ((inserted (nth insertion-index insertions)))
    (multiple-value-bind (line column)
        (%model-position-at reference offset)
      (buffer-set-point buffer line column))
    (buffer-insert-string buffer inserted)
    (values (concatenate 'string
                         (subseq reference 0 offset)
                         inserted
                         (subseq reference offset))
            state))))))

(defun %model-apply-deletion (buffer reference state)
  (let ((size (length reference)))
    (multiple-value-bind (start state)
        (%model-random-index state size)
      (multiple-value-bind (length state)
          (%model-random-index state (1+ (- size start)))
        (let ((end (+ start length)))
    (multiple-value-bind (start-line start-column)
        (%model-position-at reference start)
      (multiple-value-bind (end-line end-column)
          (%model-position-at reference end)
        (buffer-delete-region buffer
                              start-line start-column
                              end-line end-column)))
    (values (concatenate 'string
                         (subseq reference 0 start)
                         (subseq reference end))
            state))))))

(describe
  "piece-table model behavior"
  (it
    "keeps mixed edits equal to a reference model"
    (let ((buffer (make-buffer :initial-content ""))
          (reference "")
          (state 17)
          (insertions (list ""
                            "a"
                            "bc"
                            (string #\Newline)
                            (format nil "x~%y")
                            (format nil "p~%q"))))
      (dotimes (_step 256)
        (multiple-value-bind (kind next-state)
            (%model-random-index state 3)
          (setf state next-state)
          (let ((size (length reference)))
          (if (or (zerop size) (zerop kind))
              (multiple-value-setq (reference state)
                (%model-apply-insertion buffer reference state insertions))
              (multiple-value-setq (reference state)
                (%model-apply-deletion buffer reference state)))))
        (expect (buffer-text buffer) :to-equal reference)
        (expect (buffer-line-count buffer)
                :to-equal (%model-line-count reference))))))

(describe "C1 buffer index and change history"
  (labels ((version (buffer)
             (loom/core/buffer::buffer-version buffer))
           (changed-since (buffer version)
             (loom/core/buffer::buffer-changed-line-since buffer version))
           (inverse (action)
             (destructuring-bind (offset removed inserted) action
               (list offset inserted removed)))
           (apply-model (text action)
             (destructuring-bind (offset removed inserted) action
               (expect (subseq text offset (+ offset (length removed)))
                       :to-equal removed)
               (concatenate 'string (subseq text 0 offset) inserted
                            (subseq text (+ offset (length removed))))))
           (check-index (buffer text)
             (expect (buffer-text buffer) :to-equal text)
             (expect (buffer-line-count buffer) :to-equal (%model-line-count text))
             (loop with start = 0
                   for line from 0
                   for end = (position #\Newline text :start start)
                   do (expect (buffer-line buffer line)
                              :to-equal (subseq text start end))
                   while end
                   do (setf start (1+ end)))
             (loop for offset from 0 to (length text)
                   do (multiple-value-bind (line column)
                          (%model-position-at text offset)
                        (let ((position (buffer-offset-position buffer offset)))
                          (expect (buffer-position-line position) :to-equal line)
                          (expect (buffer-position-column position) :to-equal column)
                          (expect (buffer-position-offset buffer line column)
                                  :to-equal offset)))))
           (apply-public (buffer text action)
             (destructuring-bind (offset removed inserted) action
               (multiple-value-bind (line column) (%model-position-at text offset)
                 (if (plusp (length removed))
                     (multiple-value-bind (end-line end-column)
                         (%model-position-at text (+ offset (length removed)))
                       (buffer-delete-region buffer line column end-line end-column))
                     (progn
                       (buffer-set-point buffer line column)
                       (buffer-insert-string buffer inserted)))))))
    (it "exports the version and invalidation query"
      (dolist (name '("BUFFER-VERSION" "BUFFER-CHANGED-LINE-SINCE" "BUFFER-NARROW-START-LINE"))
        (multiple-value-bind (symbol status) (find-symbol name :loom/core/buffer)
          (expect status :to-equal :external)
          (expect (and symbol (fboundp symbol)) :to-be-truthy))))
    (cl-weave:it-property
        "matches a string model with history replay across narrowed bounds"
        ((seed (cl-weave:gen-integer :min 1 :max 2147483647)))
      (let* ((reference (format nil "ab~%~%cd~%"))
             (buffer (make-buffer :initial-content reference))
             (state seed)
             (undo nil)
             (redo nil)
             (events nil)
             (versions (list (version buffer)))
             (operations nil)
             (narrow-history-count 0)
             (prefix-history-count 0)
             (start 0)
             (end (length reference)))
        (labels ((pick (limit)
                   (multiple-value-bind (value next-state)
                       (%model-random-index state limit)
                     (setf state next-state)
                     value)))
          ;; The prefix guarantees narrowed replay without consuming the LCG state.
          (dotimes (step 36)
            (let* ((old-version (version buffer))
                   (kind (if (< step 4) (nth step '(4 0 2 3)) (pick 6)))
                   (action nil))
              (push kind operations)
              (case kind
                (0
                 (let* ((offset (+ start (if (= step 1)
                                                 (mod seed (1+ (- end start)))
                                                 (pick (1+ (- end start))))))
                        (text (nth (if (= step 1) (mod seed 5) (pick 5))
                                   (list "a" "bc" (string #\Newline)
                                         (format nil "x~%y")
                                         (format nil "~%~%")))))
                   (setf action (list offset "" text))
                   (buffer-record-undo-boundary buffer)
                   (apply-public buffer reference action)
                   (push (inverse action) undo)
                   (setf redo nil)))
                (1
                 (when (< start end)
                   (let* ((offset (+ start (pick (- end start))))
                          (count (1+ (pick (- end offset)))))
                     (setf action
                           (list offset (subseq reference offset (+ offset count)) ""))
                     (buffer-record-undo-boundary buffer)
                     (apply-public buffer reference action)
                     (push (inverse action) undo)
                     (setf redo nil))))
                ((2 3)
                 (let ((candidate (if (= kind 2) (first undo) (first redo))))
                   (when (and candidate
                              (or (plusp start) (< end (length reference))))
                     (incf narrow-history-count)
                     (when (< step 4) (incf prefix-history-count)))
                   (if (= kind 2)
                       (progn
                         (setf action (pop undo))
                         (buffer-undo buffer)
                         (when action
                           (push (inverse action) undo)
                           (push (inverse action) redo)))
                       (progn
                         (setf action (pop redo))
                         (buffer-redo buffer)
                         (when action (push (inverse action) undo))))))
                (4
                 (let* ((new-start (if (zerop step) 1
                                       (+ start (pick (1+ (- end start))))))
                        (new-end (if (zerop step) (1- (length reference))
                                     (+ new-start (pick (1+ (- end new-start)))))))
                   (multiple-value-bind (line column)
                       (%model-position-at reference new-start)
                     (multiple-value-bind (end-line end-column)
                         (%model-position-at reference new-end)
                       (buffer-narrow-to-region buffer line column end-line end-column)))
                   (setf start new-start end new-end)))
                (5
                 (buffer-widen buffer)
                 (setf start 0 end (length reference))))
              (if action
                  (progn
                    (push (cons (version buffer)
                                (nth-value 0 (%model-position-at reference (first action))))
                          events)
                    (destructuring-bind (offset removed inserted) action
                      (flet ((move-bound (bound end-p)
                               (let ((after-delete
                                       (- bound (min (length removed)
                                                     (max 0 (- bound offset))))))
                                 (+ after-delete
                                    (if (if end-p
                                            (<= offset after-delete)
                                            (< offset after-delete))
                                        (length inserted) 0)))))
                        (setf end (move-bound end t)
                              start (move-bound start nil))))
                    (setf reference (apply-model reference action))
                    (expect (version buffer) :to-equal (1+ old-version)))
                  (expect (version buffer) :to-equal old-version))
              (check-index buffer reference)
              (expect (buffer-narrow-start-offset buffer) :to-equal start)
              (expect (loom/core/buffer::buffer-narrow-start-line buffer)
                      :to-equal (nth-value 0 (%model-position-at reference start)))
              (expect (buffer-narrow-end-offset buffer) :to-equal end)
              (expect (buffer-visible-text buffer) :to-equal (subseq reference start end))
              (expect (buffer-visible-line-count buffer)
                      :to-equal (%model-line-count (subseq reference start end)))
              (expect (changed-since buffer (version buffer)) :to-equal nil)
              (dolist (old versions)
                (let ((lines (loop for (revision . line) in events
                                   when (> revision old) collect line)))
                  (if lines
                      (let ((actual (changed-since buffer old)))
                        (expect (and (integerp actual)
                                     (<= 0 actual (reduce #'min lines)))
                                :to-be-truthy))
                      (expect (changed-since buffer old) :to-equal nil))))
              (push (version buffer) versions))))
        (expect (plusp narrow-history-count) :to-be-truthy)
        (expect prefix-history-count :to-equal 2)
        (format t "~&C1-MODEL-TRACE seed=~D narrowed-replays=~D prefix-replays=~D random-replays=~D operations=~S~%"
                seed narrow-history-count prefix-history-count
                (- narrow-history-count prefix-history-count) (reverse operations))
        t))
    (cl-weave:it-property
        "matches a string model with mandatory outside undo and redo"
        ((seed (cl-weave:gen-integer :min 1 :max 2147483647)))
      (let ((replays 0))
        ;; Every seed covers before, after, exact boundaries, crossing, and collapse.
        (dolist (spec '((1 0 "XX") (2 0 "XX") (3 0 "XX")
                        (5 0 "XX") (6 0 "XX") (7 0 "XX")
                        (9 0 "XX") (1 0 "XXXXXXXX")
                        (1 2 "") (3 2 "") (5 2 "")
                        (7 2 "") (9 2 "")))
          (destructuring-bind (offset count inserted) spec
            (let* ((original (coerce (loop for index below 20
                                          collect (if (zerop (mod (+ seed index) 5))
                                                      #\Newline #\a)) 'string))
                   (buffer (make-buffer :initial-content original))
                   (action (list offset (subseq original offset (+ offset count)) inserted))
                   (text (apply-model original action))
                   (start 3)
                   (end 7))
              (apply-public buffer original action)
              (multiple-value-bind (line column) (%model-position-at text start)
                (multiple-value-bind (end-line end-column) (%model-position-at text end)
                  (buffer-narrow-to-region buffer line column end-line end-column)))
              (dolist (replay (list (inverse action) action))
                (let ((old-version (version buffer)))
                  (if (zerop (mod replays 2)) (buffer-undo buffer) (buffer-redo buffer))
                  (incf replays)
                  (destructuring-bind (position removed added) replay
                    ;; Model the restriction as a slice: remove overlap to each boundary,
                    ;; then include additions exactly at either end.
                    (let ((left-removed (min (length removed) (max 0 (- start position))))
                          (right-removed (min (length removed) (max 0 (- end position)))))
                      (decf start left-removed)
                      (decf end right-removed)
                      (when (< position start) (incf start (length added)))
                      (when (<= position end) (incf end (length added)))))
                  (setf text (apply-model text replay))
                  (expect (version buffer) :to-equal (1+ old-version))
                  (check-index buffer text)
                  (expect (buffer-narrow-start-offset buffer) :to-equal start)
                  (expect (buffer-narrow-end-offset buffer) :to-equal end)
                  (expect (<= 0 start end (length text)) :to-be-truthy)
                  (expect (buffer-visible-text buffer) :to-equal (subseq text start end))
                  (expect (buffer-visible-line-count buffer)
                          :to-equal (%model-line-count (subseq text start end)))
                  (expect (changed-since buffer old-version)
                          :to-equal (nth-value 0 (%model-position-at
                                                 (if (zerop (mod replays 2)) original
                                                     (apply-model original action))
                                                 (first replay)))))))))
        (expect replays :to-equal 26)
        (format t "~&C2-OUTSIDE-TRACE seed=~D replays=~D~%" seed replays)
        t))
    (it "reports absolute changed lines while narrowed and after history replay"
      (let* ((buffer (make-buffer :initial-content (format nil "a~%b~%c~%d")))
             (initial (version buffer)))
        (buffer-narrow-to-region buffer 2 0 3 1)
        (expect (version buffer) :to-equal initial)
        (buffer-set-point buffer 2 0)
        (buffer-insert-string buffer "x")
        (expect (version buffer) :to-equal (1+ initial))
        (expect (changed-since buffer initial) :to-equal 2)
        (buffer-undo buffer)
        (expect (version buffer) :to-equal (+ initial 2))
        (buffer-redo buffer)
        (expect (version buffer) :to-equal (+ initial 3))
        (expect (changed-since buffer initial) :to-equal 2)
        (check-index buffer (format nil "a~%b~%xc~%d"))))
    (it "falls back to line zero once the bounded history has expired"
      (let* ((buffer (make-buffer :initial-content (format nil "a~%b~%")))
             (initial (version buffer)))
        (buffer-set-point buffer 2 0)
        (dotimes (index 257)
          (declare (ignore index))
          (buffer-insert-string buffer "x"))
        (expect (changed-since buffer initial) :to-equal 0)
        (expect (changed-since buffer (1- (version buffer))) :to-equal 2)))))

(describe "C1 buffer asynchronous interruption"
  (labels ((interrupt-at (buffer name occurrence operation)
             (let* ((original (symbol-function name))
                    (target sb-thread:*current-thread*)
                    (tag (list :c1-interrupt))
                    (ready (sb-thread:make-semaphore))
                    (queued (sb-thread:make-semaphore))
                    (calls 0)
                    (delivered nil)
                    (sender nil))
               (labels ((request-interrupt ()
                          (sb-thread:signal-semaphore ready)
                          (let ((deadline (+ (get-internal-real-time)
                                             (* 2 internal-time-units-per-second))))
                            ;; Blocking waits may temporarily enable local interrupts.
                            (loop until (sb-thread:try-semaphore queued)
                                  when (> (get-internal-real-time) deadline)
                                    do (error "C1 interrupt sender did not acknowledge")))))
                 (unwind-protect
                      (progn
                        (setf (symbol-function name)
                              (lambda (&rest arguments)
                                (multiple-value-prog1 (apply original arguments)
                                  (when (and (eq (first arguments) buffer)
                                             (= (incf calls) occurrence))
                                    (request-interrupt)))))
                        (setf sender
                              (sb-thread:make-thread
                               (lambda ()
                                 (when (sb-thread:wait-on-semaphore ready :timeout 2)
                                   (unwind-protect
                                        (sb-thread:interrupt-thread
                                         target
                                         (lambda ()
                                           (setf delivered t)
                                           (throw tag :interrupted)))
                                     (sb-thread:signal-semaphore queued))))
                               :name "C1 interruption injector"))
                        (expect
                         (catch tag
                           (funcall operation)
                           :returned)
                         :to-equal :interrupted))
                   (sb-sys:without-interrupts
                     (setf (symbol-function name) original))
                   (when sender (sb-thread:join-thread sender)))
                 (expect delivered :to-be-truthy)
                 (expect (>= calls occurrence) :to-be-truthy))))
           (point-is (buffer offset)
             (expect (buffer-point-offset buffer) :to-equal offset)))
    (it "commits an interrupted insertion together with its undo and point"
      (dotimes (trial 12)
        (let* ((before (format nil "a~%b~%"))
               (buffer (make-buffer :initial-content before))
               (text (format nil "x~%~D" trial))
               (after (concatenate 'string "a" text (subseq before 1))))
          (buffer-set-point buffer 0 1)
          (interrupt-at buffer 'loom/core/buffer::%raw-insert-at 1
                        (lambda () (buffer-insert-string buffer text)))
          (expect (buffer-text buffer) :to-equal after)
          (point-is buffer (+ 1 (length text)))
          (buffer-undo buffer)
          (expect (buffer-text buffer) :to-equal before))))
    (it "commits interrupted region and backward deletions with undo and point"
      (dolist (kind '(:region :backward))
        (dotimes (trial 12)
          (let* ((before (format nil "a~%~Db~%c" trial))
                 (buffer (make-buffer :initial-content before)))
            (buffer-set-point buffer 1 0)
            (interrupt-at buffer 'loom/core/buffer::%raw-delete-region 1
                          (lambda ()
                            (if (eq kind :region)
                                (buffer-delete-region buffer 0 1 1 0)
                                (buffer-delete-char buffer :backward t))))
            (expect (buffer-text buffer)
                    :to-equal (concatenate 'string "a" (subseq before 2)))
            (point-is buffer 1)
            (buffer-undo buffer)
            (expect (buffer-text buffer) :to-equal before)))))
    (it "protects the entire undo and redo group against asynchronous escape"
      (dolist (kind '(:undo :redo))
        (dotimes (trial 12)
          (let* ((before (format nil "base~D" trial))
                 (buffer (make-buffer :initial-content before))
                 (after (concatenate 'string "xy" before)))
            (buffer-insert-string buffer "x")
            (buffer-insert-string buffer "y")
            (when (eq kind :redo) (buffer-undo buffer))
            (interrupt-at buffer 'loom/core/buffer::%apply-undo-entry 1
                          (lambda ()
                            (if (eq kind :undo)
                                (buffer-undo buffer)
                                (buffer-redo buffer))))
            (expect (buffer-text buffer)
                    :to-equal (if (eq kind :undo) before after))
            (if (eq kind :undo) (buffer-redo buffer) (buffer-undo buffer))
            (expect (buffer-text buffer)
                    :to-equal (if (eq kind :undo) after before))))))))

(describe "C1 buffer interruption at generated scheduling points"
  (it "keeps complete long-suffix edits and their point across asynchronous escape"
    (let ((state 731)
          (inside-count 0)
          (pending-counts (make-array 4 :initial-element 0)))
      (dotimes (trial 24)
        (let* ((kind (mod trial 4))
               (base (with-output-to-string (stream)
                       (dotimes (line 40000) (format stream "line ~D~%" line))))
               (buffer (make-buffer :initial-content base))
               (inserted (format nil "x~%~Dy~%" trial))
               (ready (sb-thread:make-semaphore))
               (tag (list :generated-interrupt))
               (delivered nil)
               (enqueue-ack (list nil))
               (enqueued nil)
               (pending-snapshot nil)
               (helper-returned-p nil)
               (started nil)
               (finished nil)
               (helper-start nil)
               (helper-end nil)
               (helper-entered-p nil)
               (sent nil))
          (when (>= kind 2)
            (buffer-insert-string buffer "x")
            (buffer-insert-string buffer "y")
            (when (= kind 3) (buffer-undo buffer)))
          (buffer-set-point buffer 0 0)
          (let* ((before (buffer-text buffer))
                 (before-point (buffer-point-offset buffer))
                 (before-undo (copy-tree (loom/core/buffer::%buffer-undo-list buffer)))
                 (before-redo (copy-tree (loom/core/buffer::%buffer-redo-list buffer)))
                 (after (case kind
                          (0 (concatenate 'string inserted base))
                          (1 (subseq base 1))
                          (2 base)
                          (3 (concatenate 'string "xy" base))))
                 (after-point (case kind (0 (length inserted)) (3 2) (t 0)))
                 (worker nil)
                 (saved nil))
            (unwind-protect
                 (progn
                   (dolist (name '(loom/core/buffer::%update-line-index-after-insert
                                   loom/core/buffer::%update-line-index-after-delete))
                     (let ((original (symbol-function name)))
                       (push (cons name original) saved)
                       (setf (symbol-function name)
                             (lambda (&rest arguments)
                               (if (and (eq (first arguments) buffer)
                                        (not helper-entered-p))
                                   (progn
                                     (setf helper-entered-p t
                                           helper-start (get-internal-real-time))
                                     (sb-thread:signal-semaphore ready)
                                     (unwind-protect
                                          (multiple-value-prog1
                                              (apply original arguments)
                                            ;; Keep the inherited mask while establishing actual enqueue.
                                            (loop until (sb-ext:compare-and-swap
                                                         (car enqueue-ack) t t)
                                                  when (>= (get-internal-real-time)
                                                           (+ helper-start
                                                              (* 2 internal-time-units-per-second)))
                                                    do (error "C1 enqueue acknowledgement timed out")
                                                  do (sb-ext:spin-loop-hint))
                                            (setf helper-returned-p t))
                                       (let* ((ack (sb-ext:compare-and-swap
                                                    (car enqueue-ack) t t))
                                              (callback-delivered delivered))
                                         (setf helper-end (get-internal-real-time)
                                               pending-snapshot
                                               (list :enqueue-ack ack
                                                     :delivered callback-delivered
                                                     :normal-return helper-returned-p
                                                     :pending (and ack helper-returned-p
                                                                   (not callback-delivered)))))))
                                   (apply original arguments))))))
                   (setf worker
                         (sb-thread:make-thread
                          (lambda ()
                            (catch tag
                              (unwind-protect
                                   (progn
                                     (setf started (get-internal-real-time))
                                     (case kind
                                       (0 (buffer-insert-string buffer inserted))
                                       (1 (buffer-delete-char buffer))
                                       (2 (buffer-undo buffer))
                                       (3 (buffer-redo buffer))))
                                (setf finished (get-internal-real-time)))
                              ;; Late requests must still land inside this catch.
                              (loop (sb-thread:thread-yield))))
                          :name "C1 long-suffix interruption target"))
                   (expect (sb-thread:wait-on-semaphore ready :timeout 2) :to-be-truthy)
                   (multiple-value-bind (delay next-state) (%model-random-index state 8)
                     (setf state next-state)
                     (sleep (* (1+ delay) 0.0002)))
                   (setf sent (get-internal-real-time))
                   (sb-thread:interrupt-thread
                    worker
                    (lambda ()
                      (setf delivered t)
                      (throw tag :interrupted)))
                   ;; SBCL 2.6.8 target-thread.lisp queues the callback before return.
                   ;; Publish only after INTERRUPT-THREAD returns; CAS is a memory barrier.
                   (setf enqueued (get-internal-real-time))
                   (sb-ext:compare-and-swap (car enqueue-ack) nil t)
                   (expect (sb-thread:join-thread worker) :to-equal :interrupted)
                   (expect delivered :to-be-truthy)
                   (expect (and started sent finished) :to-be-truthy)
                   (expect (and helper-entered-p helper-start helper-end) :to-be-truthy)
                   (let ((inside (< helper-start sent helper-end))
                         (pending (getf pending-snapshot :pending)))
                     (when pending (incf (aref pending-counts kind)))
                     (when inside (incf inside-count))
                     (format t "~&C1-STRESS trial=~D kind=~D start=~D sent=~D enqueued=~D end=~D helper-start=~D helper-end=~D inside=~S exit-snapshot=~S~%"
                             trial kind started sent enqueued finished helper-start helper-end
                             inside pending-snapshot))
                   ;; Both acceptable complete states are computed before the worker starts.
                   (let ((actual (buffer-text buffer)))
                     (multiple-value-bind (expected-line expected-column)
                         (%model-position-at after after-point)
                       (format t "~&C1-STATE trial=~D kind=~D lengths=~S prefixes=~S point-slots=~S expected-after-slots=~S history-lengths=~S~%"
                               trial kind (list (length actual) (length before) (length after))
                               (mapcar (lambda (text) (subseq text 0 (min 24 (length text))))
                                       (list actual before after))
                               (list (loom/core/buffer::%buffer-point-line buffer)
                                     (loom/core/buffer::%buffer-point-column buffer))
                               (list expected-line expected-column)
                               (list (length (loom/core/buffer::%buffer-undo-list buffer))
                                     (length (loom/core/buffer::%buffer-redo-list buffer)))))
                     (expect (or (string= actual before) (string= actual after))
                             :to-be-truthy)
                     (if (string= actual before)
                         (progn
                           (expect (buffer-point-offset buffer) :to-equal before-point)
                           (expect (loom/core/buffer::%buffer-undo-list buffer)
                                   :to-equal before-undo)
                           (expect (loom/core/buffer::%buffer-redo-list buffer)
                                   :to-equal before-redo))
                         (progn
                           (expect (buffer-point-offset buffer) :to-equal after-point)
                           (if (= kind 2) (buffer-redo buffer) (buffer-undo buffer))
                           (expect (buffer-text buffer) :to-equal before)))))
              (when (and worker (sb-thread:thread-alive-p worker))
                (sb-thread:terminate-thread worker)
                (sb-thread:join-thread worker :default nil))
              (sb-sys:without-interrupts
                (dolist (entry saved)
                  (setf (symbol-function (car entry)) (cdr entry))))))))
      (format t "~&C1-STRESS inside-count=~D trials=24~%" inside-count)
      (expect (plusp inside-count) :to-be-truthy)
      (format t "~&C1-STRESS pending-at-helper-exit-by-kind=~S~%"
              (coerce pending-counts 'list))
      (dotimes (kind 4)
        (expect (plusp (aref pending-counts kind)) :to-be-truthy)))))



(describe "C1 packed index and primitive history boundaries"
  (labels ((model-starts (text)
             (coerce (cons 0 (loop for character across text
                                     for offset from 1
                                     when (char= character #\Newline)
                                       collect offset))
                     'vector))
           (check-state (buffer text boundary)
             (let* ((starts (model-starts text))
                    (last (1- (length starts)))
                    (lines (remove-duplicates
                            (append (list 0 1 last)
                                    (loop for line from (- boundary 6)
                                            to (+ boundary 6)
                                          when (<= 0 line last) collect line)))))
               (expect (buffer-text buffer) :to-equal text)
               (expect (buffer-line-count buffer) :to-equal (length starts))
               (dolist (line lines)
                 (let* ((start (aref starts line))
                        (end (if (< line last)
                                 (1- (aref starts (1+ line)))
                                 (length text))))
                   (expect (buffer-line buffer line) :to-equal (subseq text start end))
                   (expect (buffer-position-offset buffer line 0) :to-equal start)
                   (dolist (offset (remove-duplicates (list start end)))
                     (let ((position (buffer-offset-position buffer offset)))
                       (expect (buffer-position-line position) :to-equal line)
                       (expect (buffer-position-column position) :to-equal (- offset start))
                       (expect (buffer-position-offset buffer line (- offset start))
                               :to-equal offset)))))))
           (piece-values (pieces)
             (mapcar (lambda (piece)
                       (list (loom/core/buffer::%piece-source piece)
                             (loom/core/buffer::%piece-start piece)
                             (loom/core/buffer::%piece-length piece)))
                     pieces)))
    (it "preserves line positions while allocating and releasing radix boundaries"
      (dolist (boundary '(1024 32768))
        (let* ((original (with-output-to-string (stream)
                           (dotimes (line (+ boundary 3))
                             (format stream "row~D~%" line))))
               (buffer (make-buffer :initial-content original))
               (offset (+ (aref (model-starts original) (1- boundary)) 2))
               (inserted (format nil "u~%v~%w"))
               (with-insertion (concatenate 'string
                                            (subseq original 0 offset)
                                            inserted
                                            (subseq original offset))))
          (check-state buffer original boundary)
          (buffer-set-point buffer (1- boundary) 2)
          (buffer-record-undo-boundary buffer)
          (buffer-insert-string buffer inserted)
          (check-state buffer with-insertion boundary)
          (buffer-undo buffer)
          (check-state buffer original boundary)
          (buffer-redo buffer)
          (check-state buffer with-insertion boundary)
          (let* ((starts (model-starts with-insertion))
                 (start (+ (aref starts (- boundary 4)) 1))
                 (end (+ (aref starts (+ boundary 4)) 2))
                 (after-deletion (concatenate 'string
                                              (subseq with-insertion 0 start)
                                              (subseq with-insertion end))))
            (buffer-record-undo-boundary buffer)
            (buffer-delete-region buffer (- boundary 4) 1 (+ boundary 4) 2)
            (check-state buffer after-deletion boundary)
            (buffer-undo buffer)
            (check-state buffer with-insertion boundary)
            (buffer-redo buffer)
            (check-state buffer after-deletion boundary)))))
    (it "counts every primitive in multi-entry undo and redo groups"
      (let* ((buffer (make-buffer :initial-content "base"))
             (initial (loom/core/buffer::buffer-version buffer)))
        (buffer-insert-string buffer (format nil "a~%"))
        (buffer-insert-string buffer "b")
        (buffer-insert-string buffer (format nil "~%c"))
        (expect (loom/core/buffer::buffer-version buffer) :to-equal (+ initial 3))
        (buffer-undo buffer)
        (expect (buffer-text buffer) :to-equal "base")
        (expect (loom/core/buffer::buffer-version buffer) :to-equal (+ initial 6))
        (buffer-redo buffer)
        (expect (buffer-text buffer) :to-equal (format nil "a~%b~%cbase"))
        (expect (loom/core/buffer::buffer-version buffer) :to-equal (+ initial 9))))
    (it "returns the exact minimum of several nonzero changed lines"
      (let* ((buffer (make-buffer :initial-content (format nil "a~%b~%c~%d~%e~%f~%g~%h")))
             (initial (loom/core/buffer::buffer-version buffer)))
        (buffer-set-point buffer 5 0)
        (buffer-insert-string buffer "x")
        (let ((after-first (loom/core/buffer::buffer-version buffer)))
          (buffer-set-point buffer 3 0)
          (buffer-insert-string buffer "y")
          (let ((after-second (loom/core/buffer::buffer-version buffer)))
            (buffer-set-point buffer 6 0)
            (buffer-insert-string buffer "z")
            (expect (loom/core/buffer::buffer-changed-line-since buffer initial)
                    :to-equal 3)
            (expect (loom/core/buffer::buffer-changed-line-since buffer after-first)
                    :to-equal 3)
            (expect (loom/core/buffer::buffer-changed-line-since buffer after-second)
                    :to-equal 6)
            (expect (loom/core/buffer::buffer-changed-line-since
                     buffer (loom/core/buffer::buffer-version buffer))
                    :to-equal nil)))))
    (it "leaves retained piece metadata unchanged when adjacent pieces coalesce"
      (let ((buffer (make-buffer :initial-content "abcd")))
        (buffer-set-point buffer 0 2)
        (buffer-insert-string buffer "x")
        (let* ((retained (loom/core/buffer::%buffer-pieces buffer))
               (snapshot (piece-values retained)))
          (buffer-insert-string buffer "y")
          (expect (piece-values retained) :to-equal snapshot)
          (expect (buffer-text buffer) :to-equal "abxycd"))
        (let* ((retained (loom/core/buffer::%buffer-pieces buffer))
               (snapshot (piece-values retained)))
          (buffer-delete-region buffer 0 2 0 4)
          (expect (piece-values retained) :to-equal snapshot)
          (expect (buffer-text buffer) :to-equal "abcd")
          (expect (length (loom/core/buffer::%buffer-pieces buffer)) :to-equal 1))))))

(describe "C1 change ring retention and narrow origin"
  (it "retains exactly 256 revisions while wrapping across changing nonzero lines"
    (let* ((buffer (make-buffer :initial-content
                                (with-output-to-string (stream)
                                  (dotimes (line 300)
                                    (format stream "row~D~%" line)))))
           (initial (loom/core/buffer::buffer-version buffer)))
      (dotimes (index 258)
        (buffer-set-point buffer (if (< index 3) (1+ index) (+ 10 (mod index 20))) 0)
        (buffer-insert-string buffer "x"))
      (let ((current (loom/core/buffer::buffer-version buffer)))
        (expect current :to-equal (+ initial 258))
        (expect (loom/core/buffer::buffer-changed-line-since buffer (- current 256))
                :to-equal 3)
        (expect (loom/core/buffer::buffer-changed-line-since buffer (- current 257))
                :to-equal 0)
        (expect (loom/core/buffer::buffer-changed-line-since buffer (- current 255))
                :to-equal 10)
        (expect (loom/core/buffer::buffer-changed-line-since buffer (1- current))
                :to-equal 27))))
  (it "invalidates from line zero for a consumer revision ahead of the buffer"
    (let ((buffer (make-buffer :initial-content "abc")))
      (buffer-insert-string buffer "x")
      (let ((current (loom/core/buffer::buffer-version buffer)))
        (expect (loom/core/buffer::buffer-changed-line-since buffer (1+ current))
                :to-equal 0)
        (expect (loom/core/buffer::buffer-changed-line-since buffer (+ current 256))
                :to-equal 0))))
  (it "reports the absolute start line for partial-line narrowing and widening"
    (let* ((buffer (make-buffer :initial-content (format nil "first~%ab~%cd~%ef~%")))
           (initial (loom/core/buffer::buffer-version buffer)))
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 0)
      (buffer-narrow-to-region buffer 1 1 3 1)
      (expect (buffer-visible-text buffer) :to-equal (format nil "b~%cd~%e"))
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 1)
      (expect (loom/core/buffer::buffer-version buffer) :to-equal initial)
      (buffer-narrow-to-region buffer 2 1 3 1)
      (expect (buffer-visible-text buffer) :to-equal (format nil "d~%e"))
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 2)
      (buffer-widen buffer)
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 0)
      (expect (loom/core/buffer::buffer-version buffer) :to-equal initial))))

(describe "C1 indexed visible buffer APIs"
  (it "represents an empty narrowed view at a trailing newline and after widening"
    (let ((buffer (make-buffer :initial-content (format nil "a~%"))))
      (buffer-narrow-to-region buffer 1 0 1 0)
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 1)
      (expect (buffer-visible-text buffer) :to-equal "")
      (expect (buffer-visible-line-count buffer) :to-equal 1)
      (expect (buffer-visible-line buffer 0) :to-equal "")
      (multiple-value-bind (lines count) (loom/core/buffer:buffer-visible-lines buffer 0 3)
        (expect lines :to-equal '(""))
        (expect count :to-equal 1))
      (let ((position (buffer-visible-offset-position buffer 2)))
        (expect (buffer-position-line position) :to-equal 0)
        (expect (buffer-position-column position) :to-equal 0))
      (expect (buffer-visible-offset-position buffer 1) :to-equal nil)
      (buffer-widen buffer)
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 0)
      (expect (buffer-visible-line-count buffer) :to-equal 2)))
  (it "keeps the empty last visible line when the narrowed view ends after a newline"
    (let ((buffer (make-buffer :initial-content (format nil "a~%b~%"))))
      (buffer-narrow-to-region buffer 0 1 1 0)
      (expect (buffer-visible-text buffer) :to-equal (string #\Newline))
      (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 0)
      (expect (buffer-visible-line-count buffer) :to-equal 2)
      (buffer-set-point buffer 1 0)
      (expect (buffer-visible-point-line buffer) :to-equal 1)
      (expect (buffer-visible-point-column buffer) :to-equal 0)
      (multiple-value-bind (lines count) (loom/core/buffer:buffer-visible-lines buffer 0 4)
        (expect lines :to-equal '("" ""))
        (expect count :to-equal 2))))
  (it "reads visible positions and lines without whole-buffer constructors"
    (let ((buffer (make-buffer :initial-content (format nil "first~%ab~%cd~%ef~%")))
          (saved nil))
      (buffer-narrow-to-region buffer 1 1 3 0)
      (buffer-set-point buffer 2 1)
      (unwind-protect
           (progn
             (dolist (name '(loom/core/buffer:buffer-text
                             loom/core/buffer::%pieces-text))
               (expect (fboundp name) :to-be-truthy)
               (unless (fboundp name)
                 (error "Forbidden whole-buffer helper is missing: ~S" name))
               (let ((original (symbol-function name))
                     (replaced-name name))
                 (push (cons name original) saved)
                 (setf (symbol-function name)
                       (lambda (observed &rest arguments)
                         (when (eq observed buffer)
                           (error "Visible API called forbidden whole-buffer helper ~S"
                                  replaced-name))
                         (apply original observed arguments)))))
             (expect (loom/core/buffer::buffer-narrow-start-line buffer) :to-equal 1)
             (expect (buffer-visible-text buffer) :to-equal (format nil "b~%cd~%"))
             (expect (buffer-visible-line-count buffer) :to-equal 3)
             (expect (buffer-visible-line buffer 0) :to-equal "b")
             (expect (buffer-visible-line buffer 1) :to-equal "cd")
             (expect (buffer-visible-line buffer 2) :to-equal "")
             (expect (buffer-visible-point-line buffer) :to-equal 1)
             (expect (buffer-visible-point-column buffer) :to-equal 1)
             (multiple-value-bind (lines count) (loom/core/buffer:buffer-visible-lines buffer 0 8)
               (expect lines :to-equal '("b" "cd" ""))
               (expect count :to-equal 3))
             (let ((position (buffer-visible-offset-position
                              buffer (buffer-narrow-end-offset buffer))))
               (expect (buffer-position-line position) :to-equal 2)
               (expect (buffer-position-column position) :to-equal 0)))
        (sb-sys:without-interrupts
          (dolist (entry saved)
            (setf (symbol-function (car entry)) (cdr entry))))))))

(describe "C1 indexed piece ranges"
  (labels ((model-lines (text)
             (loop with start = 0
                   for end = (position #\Newline text :start start)
                   collect (subseq text start end)
                   while end do (setf start (1+ end))))
           (model-offset (text line column)
             (loop with offset = 0
                   repeat line
                   do (setf offset (1+ (position #\Newline text :start offset)))
                   finally (return (+ offset column))))
           (check-cold-line (buffer text line)
             (let* ((start (model-offset text line 0))
                    (end (or (position #\Newline text :start start) (length text)))
                    (expected (loop with cursor = 0
                                    for piece in (loom/core/buffer::%buffer-pieces buffer)
                                    for next = (+ cursor (loom/core/buffer::%piece-length piece))
                                    when (and (< cursor end) (> next start)) collect cursor
                                    do (setf cursor next)))
                    (visited nil)
                    (thread sb-thread:*current-thread*)
                    (name 'loom/core/buffer::%piece-range-overlap)
                    (original (symbol-function name)))
               (expect expected :to-be-truthy)
               (expect (plusp (first expected)) :to-be-truthy)
               (unwind-protect
                    (progn
                      (setf (symbol-function name)
                            (lambda (cursor next observed-start observed-end)
                              (when (and (eq sb-thread:*current-thread* thread)
                                         (= observed-start start) (= observed-end end))
                                (push cursor visited))
                              (funcall original cursor next observed-start observed-end)))
                      (expect (buffer-visible-line buffer line)
                              :to-equal (subseq text start end))
                      (expect (reverse visited) :to-equal expected)
                      (format t "~&C1-PIECE-RANGE line=~D pieces=~D start=~D end=~D expected=~S visited=~S~%"
                              line (length (loom/core/buffer::%buffer-pieces buffer))
                              start end expected (reverse visited)))
                 (sb-sys:without-interrupts
                   (setf (symbol-function name) original)))))
           (check-pieces (buffer text)
             (let ((pieces (loom/core/buffer::%buffer-pieces buffer))
                   (vector (loom/core/buffer::%buffer-piece-vector buffer))
                   (starts (loom/core/buffer::%buffer-piece-starts buffer))
                   (offset 0))
               (expect (typep vector 'simple-vector) :to-be-truthy)
               (expect (typep starts '(simple-array fixnum (*))) :to-be-truthy)
               (expect (length vector) :to-equal (length pieces))
               (expect (length starts) :to-equal (length pieces))
               (loop for piece in pieces for i from 0
                     for size = (loom/core/buffer::%piece-length piece)
                     do (expect (eq (aref vector i) piece) :to-be-truthy)
                        (expect (aref starts i) :to-equal offset)
                        (expect (loom/core/buffer::%piece-index-at-offset buffer offset)
                                :to-equal i)
                        (expect (loom/core/buffer::%piece-index-at-offset
                                 buffer (+ offset size -1)) :to-equal i)
                        (incf offset size))
               (expect offset :to-equal (length text))
               (expect (buffer-text buffer) :to-equal text)
               (expect (loom/core/buffer::%piece-table-range-text buffer 0 0) :to-equal "")
               (expect (loom/core/buffer::%piece-table-range-text buffer offset offset)
                       :to-equal "")
               (loop for i from (max 0 (- (length starts) 8)) below (length starts)
                     for start = (aref starts i)
                     for end = (min offset (+ start 9))
                     do (expect (loom/core/buffer::%piece-table-range-text buffer start end)
                                :to-equal (subseq text start end))
                        (when (< (1+ start) end)
                          (expect (loom/core/buffer::%piece-table-range-text
                                   buffer (1+ start) end)
                                  :to-equal (subseq text (1+ start) end)))))))
    (it "indexes empty and initial piece ranges"
      (check-pieces (make-buffer :initial-content "") "")
      (check-pieces (make-buffer :initial-content "abc") "abc"))
    (it "reads late fragmented ranges after edits, replay, and sliced narrowing"
      (let* ((reference (with-output-to-string (stream)
                          (dotimes (line 256) (format stream "row~D~%" line))))
             (buffer (make-buffer :initial-content reference)))
        (dotimes (line 256)
          (let ((offset (model-offset reference line 1)))
            (buffer-set-point buffer line 1)
            (buffer-insert-string buffer "x")
            (setf reference (concatenate 'string (subseq reference 0 offset)
                                         "x" (subseq reference offset)))))
        (expect (>= (length (loom/core/buffer::%buffer-pieces buffer)) 512)
                :to-be-truthy)
        (check-pieces buffer reference)
        (let* ((before reference)
               (offset (model-offset reference 250 1))
               (inserted (format nil "u~%v")))
          (buffer-record-undo-boundary buffer)
          (buffer-set-point buffer 250 1)
          (buffer-insert-string buffer inserted)
          (setf reference (concatenate 'string (subseq before 0 offset)
                                       inserted (subseq before offset)))
          (check-pieces buffer reference)
          (buffer-undo buffer)
          (check-pieces buffer before)
          (buffer-redo buffer)
          (check-pieces buffer reference))
        (let* ((before reference)
               (start (model-offset before 252 1))
               (end (model-offset before 253 2)))
          (buffer-record-undo-boundary buffer)
          (buffer-delete-region buffer 252 1 253 2)
          (setf reference (concatenate 'string (subseq before 0 start) (subseq before end)))
          (check-pieces buffer reference)
          (buffer-undo buffer)
          (check-pieces buffer before)
          (buffer-redo buffer)
          (check-pieces buffer reference))
        (let* ((lines (model-lines reference))
               (late (subseq lines 250)))
          (check-cold-line buffer reference 254)
          (multiple-value-bind (actual count)
              (loom/core/buffer:buffer-visible-lines buffer 250 20)
            (expect actual :to-equal late)
            (expect count :to-equal (length lines))))
        (let* ((start (model-offset reference 250 1))
               (end (model-offset reference 252 2))
               (visible (subseq reference start end))
               (lines (model-lines visible)))
          (buffer-narrow-to-region buffer 250 1 252 2)
          (expect (buffer-visible-text buffer) :to-equal visible)
          (expect (loom/core/buffer:buffer-narrow-start-line buffer) :to-equal 250)
          (expect (buffer-visible-line-count buffer) :to-equal (length lines))
          (multiple-value-bind (actual count)
              (loom/core/buffer:buffer-visible-lines buffer 0 20)
            (expect actual :to-equal lines)
            (expect count :to-equal (length lines)))
          (loop for line in lines for i from 0
                do (expect (buffer-visible-line buffer i) :to-equal line))
          (buffer-set-point buffer 251 1)
          (expect (buffer-visible-point-line buffer) :to-equal 1)
          (expect (buffer-visible-point-column buffer) :to-equal 1)
          (buffer-widen buffer)
          (check-pieces buffer reference))))))
