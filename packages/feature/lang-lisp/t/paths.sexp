((:id "r1:lang-lisp:indent-ret" :commands (:newline) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"enter\",\"modifiers\":[]}]}" :state "Common Lisp when form with closing delimiter on next line" :outcome "RET inserts a two-column body indent" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-ret" :lane "W3-7b") (:id "r1:lang-lisp:indent-tab" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp call with a first argument" :outcome "TAB aligns under the first argument" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-tab" :lane "W3-7b") (:id "r1:lang-lisp:indent-special-forms" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp nested defun let and when forms with string and comments" :outcome "TAB indents each nested body and ignores comment and string delimiters" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-special-forms" :lane "W3-7b") (:id "r1:lang-lisp:indent-elisp" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Emacs Lisp nested defun let when and lambda forms" :outcome "TAB indents each nested body and ignores comment and string delimiters" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-elisp" :lane "W3-7b") (:id "r1:lang-lisp:indent-cl-flet-loop" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp multiline flet body and loop clauses" :outcome "TAB indents flet body and loop clause to the Emacs macro indentation columns" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-cl-flet-loop" :lane "W3-7b") (:id "r1:lang-lisp:indent-region" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"\\\\\",\"modifiers\":[\"alt\",\"control\"]}]}" :state "Common Lisp nested body with active region" :outcome "C-M-\\ reindents the active region and adjusts point" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-region" :lane "W3-7b") (:id "r1:lang-lisp:indent-cl-lambda" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp lambda body" :outcome "TAB indents the lambda body by two columns" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-cl-lambda" :lane "W3-7b") (:id "r1:lang-lisp:indent-nested-block-comment" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp nested block comment before a body form" :outcome "TAB ignores parentheses inside nested #| comments" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-nested-block-comment" :lane "W3-7b") (:id "r1:lang-lisp:indent-emacs-cases" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp COND, CASE, DEFVAR, docstring, and LOOP forms on following lines" :outcome "TAB follows Emacs columns for clauses, operands, docstrings, and LOOP keywords" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent-emacs-cases" :lane "W3-7b") (:id "r1:lang-lisp:structural-forward-slurp-sexp-cl" :commands (:forward-char :forward-slurp-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"right\",\"modifiers\":[\"control\"]}]}" :state "Common Lisp buffer (a) b with point at column 1" :outcome "C-Right slurps the following form into the enclosing list; file bytes become (a b) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-forward-slurp-sexp-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-forward-barf-sexp-cl" :commands (:forward-char :forward-barf-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"left\",\"modifiers\":[\"control\"]}]}" :state "Common Lisp buffer (a b) with point at column 1" :outcome "C-Left barfs the last form out of the enclosing list; file bytes become (a) b and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-forward-barf-sexp-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-backward-slurp-sexp-cl" :commands (:forward-char :backward-slurp-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"left\",\"modifiers\":[\"alt\",\"control\"]}]}" :state "Common Lisp buffer a (b) with point at column 3" :outcome "C-M-Left slurps the preceding form into the enclosing list; file bytes become (a b) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-backward-slurp-sexp-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-backward-barf-sexp-cl" :commands (:forward-char :backward-barf-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"right\",\"modifiers\":[\"alt\",\"control\"]}]}" :state "Common Lisp buffer (a b) with point at column 1" :outcome "C-M-Right barfs the first form out of the enclosing list; file bytes become a (b) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-backward-barf-sexp-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-wrap-round-cl" :commands (:wrap-round :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"(\",\"modifiers\":[\"alt\"]}]}" :state "Common Lisp buffer a b with point at column 0" :outcome "M-( wraps the expression after point in parentheses; file bytes become (a) b and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-wrap-round-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-splice-sexp-cl" :commands (:forward-char :splice-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"s\",\"modifiers\":[\"alt\"]}]}" :state "Common Lisp buffer (a (b c) d) with point at column 4" :outcome "M-s removes the enclosing list delimiters; file bytes become (a b c d) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-splice-sexp-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-raise-sexp-cl" :commands (:forward-char :raise-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\"r\",\"modifiers\":[\"alt\"]}]}" :state "Common Lisp buffer (a (b c) d) with point at column 3" :outcome "M-r raises the expression at point over its enclosing list; file bytes become (b c) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-raise-sexp-cl" :lane "W3-7b") (:id "r1:lang-lisp:structural-forward-slurp-sexp-el" :commands (:forward-char :forward-slurp-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"right\",\"modifiers\":[\"control\"]}]}" :state "Emacs Lisp buffer (a) b with point at column 1" :outcome "C-Right slurps the following form into the enclosing list; file bytes become (a b) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-forward-slurp-sexp-el" :lane "W3-7b") (:id "r1:lang-lisp:structural-forward-barf-sexp-el" :commands (:forward-char :forward-barf-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"left\",\"modifiers\":[\"control\"]}]}" :state "Emacs Lisp buffer (a b) with point at column 1" :outcome "C-Left barfs the last form out of the enclosing list; file bytes become (a) b and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-forward-barf-sexp-el" :lane "W3-7b") (:id "r1:lang-lisp:structural-backward-slurp-sexp-el" :commands (:forward-char :backward-slurp-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"left\",\"modifiers\":[\"alt\",\"control\"]}]}" :state "Emacs Lisp buffer a (b) with point at column 3" :outcome "C-M-Left slurps the preceding form into the enclosing list; file bytes become (a b) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-backward-slurp-sexp-el" :lane "W3-7b") (:id "r1:lang-lisp:structural-backward-barf-sexp-el" :commands (:forward-char :backward-barf-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"right\",\"modifiers\":[\"alt\",\"control\"]}]}" :state "Emacs Lisp buffer (a b) with point at column 1" :outcome "C-M-Right barfs the first form out of the enclosing list; file bytes become a (b) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-backward-barf-sexp-el" :lane "W3-7b") (:id "r1:lang-lisp:structural-wrap-round-el" :commands (:wrap-round :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"(\",\"modifiers\":[\"alt\"]}]}" :state "Emacs Lisp buffer a b with point at column 0" :outcome "M-( wraps the expression after point in parentheses; file bytes become (a) b and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-wrap-round-el" :lane "W3-7b") (:id "r1:lang-lisp:structural-splice-sexp-el" :commands (:forward-char :splice-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"s\",\"modifiers\":[\"alt\"]}]}" :state "Emacs Lisp buffer (a (b c) d) with point at column 4" :outcome "M-s removes the enclosing list delimiters; file bytes become (a b c d) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-splice-sexp-el" :lane "W3-7b") (:id "r1:lang-lisp:structural-raise-sexp-el" :commands (:forward-char :raise-sexp :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\"r\",\"modifiers\":[\"alt\"]}]}" :state "Emacs Lisp buffer (a (b c) d) with point at column 3" :outcome "M-r raises the expression at point over its enclosing list; file bytes become (b c) and point is checked" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/structural-raise-sexp-el" :lane "W3-7b") (:id "r1:lang-lisp:comment-cl" :commands (:mode/comment-dwim :move-beginning-of-line :set-mark-command :next-line :move-end-of-line :save-buffer) :rule :r1 :entry "key:M-;" :state "Common Lisp buffer with the first two lines selected" :outcome "M-; comments the selected lines and preserves point" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/comment-dwim-cl" :lane "W3-7b") (:id "r1:lang-lisp:comment-elisp" :commands (:mode/comment-dwim :move-beginning-of-line :set-mark-command :next-line :move-end-of-line :save-buffer) :rule :r1 :entry "key:M-;" :state "Emacs Lisp buffer with the first two lines selected" :outcome "M-; comments the selected lines and preserves point" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/comment-dwim-el" :lane "W3-7b") (:id "r1:lang-lisp:pair-skip-cl" :commands (:core/self-insert :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"common-lisp\",\"sequence\":[{\"key\":\")\",\"modifiers\":[]}]}" :state "Common Lisp buffer with point before an existing paired closer" :outcome "Typing ) skips the existing closer, keeps exact bytes, and advances point" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/pair-skip-cl" :lane "W3-7b") (:id "r1:lang-lisp:pair-skip-el" :commands (:core/self-insert :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"emacs-lisp\",\"sequence\":[{\"key\":\")\",\"modifiers\":[]}]}" :state "Emacs Lisp buffer with point before an existing paired closer" :outcome "Typing ) skips the existing closer, keeps exact bytes, and advances point" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/pair-skip-el" :lane "W3-7b")
 (:id "r1:lang-lisp:mode-assignment" :commands (:find-file) :rule :r1 :entry "path extension" :state ".asd and .el files opened" :outcome ".asd selects Common Lisp mode and .el selects Emacs Lisp mode" :observe (:screen_text :file_bytes :cursor) :scenario "lang-lisp/command-path-mode-assignment" :lane "W3-7b")
 (:id "r1:lang-lisp:indent-ret-elisp" :commands (:move-end-of-line :newline :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"enter\",\"modifiers\":[]}]}" :state "Emacs Lisp form with a closing delimiter on the next line" :outcome "RET inserts an Emacs Lisp body indent" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/command-path-indent-ret-elisp" :lane "W3-7b")
 (:id "r1:lang-lisp:indent-region-elisp" :commands (:move-beginning-of-line :set-mark-command :next-line :move-end-of-line :indent-for-tab-command :save-buffer) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"\\\\\",\"modifiers\":[\"alt\",\"control\"]}]}" :state "Emacs Lisp nested body with an active region" :outcome "Control-Meta-backslash reindents the active region and adjusts point" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/command-path-indent-region-elisp" :lane "W3-7b")
)
