((:id "r1:lang-lisp:indent-ret" :commands (:newline) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"enter\",\"modifiers\":[]}]}" :state "Common Lisp when form" :outcome "RET inserts a two-column body indent" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent" :lane "W3-7b") (:id "r1:lang-lisp:indent-tab" :commands (:indent-for-tab-command) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"tab\",\"modifiers\":[]}]}" :state "Common Lisp call with a first argument" :outcome "TAB aligns under the first argument" :observe (:screen_text :cursor :file_bytes) :scenario "lang-lisp/indent" :lane "W3-7b"))
