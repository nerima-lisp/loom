 (:id "r1:buffer-menu:one-window-split-quit" :commands (:list-buffers :buffer-menu-quit) :rule :r1 :entry "keys: C-x C-b, C-x o, q" :state "one window with point after the first line start" :outcome "C-x C-b splits and keeps point in the origin window; q deletes the list window" :observe (:screen_text :cursor) :scenario "buffer-menu/one-window-split-quit" :lane "W3-3")
 (:id "r1:buffer-menu:two-window-reuse-quit" :commands (:list-buffers :buffer-menu-quit) :rule :r1 :entry "keys: C-x C-b in the lower of two windows, C-x o, q" :state "two windows, the upper one showing another buffer" :outcome "C-x C-b reuses the upper window; q restores its previous buffer and keeps both windows" :observe (:screen_text :cursor) :scenario "buffer-menu/two-window-reuse-quit" :lane "W3-3")
 (:id "r1:buffer-menu:mark-replacement" :commands (:list-buffers :buffer-menu-delete :buffer-menu-save) :rule :r1 :entry "keys: d, p, s" :state "buffer list line marked D" :outcome "s replaces the D mark with S on the same line" :observe (:screen_text :cursor) :scenario "buffer-menu/mark-replacement" :lane "W3-3")
 (:id "r1:buffer-menu:execute-stops-on-cancelled-save" :commands (:list-buffers :buffer-menu-save :buffer-menu-delete :buffer-menu-execute) :rule :r1 :entry "keys: s, d, x, C-g" :state "S line whose file changed on disk and a later D line" :outcome "C-g at the overwrite prompt stops x; both marks stay and nothing is killed or written" :observe (:screen_text :file_bytes) :scenario "buffer-menu/execute-stops-on-cancelled-save" :lane "W3-3")
)
