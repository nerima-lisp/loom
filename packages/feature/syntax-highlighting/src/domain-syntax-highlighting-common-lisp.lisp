
(in-package #:loom/feature/syntax-highlighting)

(defun %syntax-delimiter-p (character)
  (or (find character '(#\( #\) #\[ #\] #\{ #\} #\' #\, #\#)
            :test #'char=)
      (char= character #\`)))

(defun %syntax-atom-end (line start)
  (let ((position start))
    (loop while (and (< position (length line))
                     (not (%syntax-whitespace-p (char line position)))
                     (not (find (char line position) '(#\; #\")))
                     (not (%syntax-delimiter-p (char line position))))
          do (incf position))
    position))

(defun %syntax-character-literal-end (line start)
  (let ((literal-start (+ start 2)))
    (if (>= literal-start (length line))
        (length line)
        (let ((character (char line literal-start)))
          (if (or (%syntax-whitespace-p character)
                  (find character '(#\; #\"))
                  (%syntax-delimiter-p character))
              (1+ literal-start)
              (%syntax-atom-end line literal-start))))))

(defun %syntax-keyword-token-p (text)
  (or (and (string/= text "")
           (char= (char text 0) #\:))
      (member text (major-mode-keywords :common-lisp) :test #'string-equal)))

(defun %syntax-token-kind (text)
  (cond ((%syntax-number-token-p text) :number)
        ((%syntax-keyword-token-p text) :keyword)
        (t :plain)))

(defun %syntax-prefixed-atom-token (line position)
  (let ((end (%syntax-atom-end line (1+ position))))
    (values (%syntax-token-kind (subseq line position end)) end)))

(defun %syntax-atom-token (line position)
  (let ((end (%syntax-atom-end line position)))
    (values (%syntax-token-kind (subseq line position end))
            end)))

(defun %syntax-string-span-end (line start)
  (let ((escaped nil))
    (loop for position from start below (length line)
          for character = (char line position)
          do (cond (escaped (setf escaped nil))
                   ((char= character #\\) (setf escaped t))
                   ((char= character #\")
                    (return-from %syntax-string-span-end
                      (values (1+ position) :code)))))
    (values (length line) :string)))

(defun %syntax-comment-span-end (line start depth)
  (let ((position start))
    (loop while (< position (length line))
          do (cond ((and (< (1+ position) (length line))
                         (char= (char line position) #\#)
                         (char= (char line (1+ position)) #\|))
                    (incf depth)
                    (incf position 2))
                   ((and (< (1+ position) (length line))
                         (char= (char line position) #\|)
                         (char= (char line (1+ position)) #\#))
                    (decf depth)
                    (incf position 2)
                    (when (zerop depth)
                      (return-from %syntax-comment-span-end
                        (values position :code))))
                   (t (incf position))))
    (values (length line) depth)))

(defun %syntax-state-code-span (line position)
  (let ((character (char line position)))
    (cond ((char= character #\;) (values :comment (length line) :code))
          ((char= character #\")
           (multiple-value-bind (end state)
               (%syntax-string-span-end line (1+ position))
             (values :string end state)))
          ((and (char= character #\#)
                (< (1+ position) (length line)))
           (case (char line (1+ position))
             (#\| (multiple-value-bind (end state)
                       (%syntax-comment-span-end line (+ position 2) 1)
                     (values :comment end state)))
             (#\\ (values :character
                          (%syntax-character-literal-end line position) :code))
             (otherwise (values :plain (1+ position) :code))))
          (t (values :plain (1+ position) :code)))))

(defun %syntax-scan-line (line state tokens-p)
  (let ((position 0)
        (tokens nil))
    (loop while (< position (length line))
          do (multiple-value-bind (kind end next-state)
                 (cond
                   ((eq state :string)
                    (multiple-value-bind (end next-state)
                        (%syntax-string-span-end line position)
                      (values :string end next-state)))
                   ((integerp state)
                    (multiple-value-bind (end next-state)
                        (%syntax-comment-span-end line position state)
                      (values :comment end next-state)))
                   ((or (not tokens-p)
                        (find (char line position) '(#\; #\" #\#)))
                    (if (and tokens-p
                             (char= (char line position) #\#)
                             (or (= (1+ position) (length line))
                                 (not (find (char line (1+ position))
                                            '(#\| #\\)))))
                        (multiple-value-bind (kind end)
                            (%syntax-prefixed-atom-token line position)
                          (values kind end :code))
                        (%syntax-state-code-span line position)))
                   ((%syntax-whitespace-p (char line position))
                    (values :whitespace (%syntax-whitespace-end line position) :code))
                   ((%syntax-delimiter-p (char line position))
                    (values :delimiter (1+ position) :code))
                   (t (multiple-value-bind (kind end)
                          (%syntax-atom-token line position)
                        (values kind end :code))))
               (when tokens-p
                 (push (%make-syntax-token kind (subseq line position end)) tokens))
               (setf position end
                     state next-state)))
    (values (nreverse tokens) state)))

(defun syntax-highlight-line (line &optional (state :code))
  "Return LINE's tokens and the reader state for the following line.
STATE is :CODE, :STRING, or a positive nested block-comment depth."
  (check-type line string)
  (%syntax-scan-line line state t))

