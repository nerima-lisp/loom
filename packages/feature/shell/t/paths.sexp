((:id "r1:pipe-command:key:%7B%22keymap%22%3A%22global%22%2C%22sequence%22%3A%5B%7B%22key%22%3A%22%21%22%2C%22modifiers%22%3A%5B%22alt%22%5D%7D%5D%7D"
  :commands (:pipe-command)
  :rule :r1
  :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"!\",\"modifiers\":[\"alt\"]}]}"
  :state "default"
  :outcome "command runs from its key sequence"
  :observe (:screen_text)
  :scenario "shell/pipe-command-key"
  :lane "W3-11")
