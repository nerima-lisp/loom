((:id "r1:evaluation:eval-last-sexp" :commands ("eval-last-sexp") :rule :r1 :lane "W3-7b" :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"e\",\"modifiers\":[\"control\"]}]}" :state "Common Lisp buffer at point before the first expression" :outcome "C-x C-e reaches eval-last-sexp and reports no preceding expression without changing the file bytes or cursor" :observe (:screen_text :cursor :file_bytes) :scenario "evaluation/eval-last-sexp")
 (:id "r1:evaluation:eval-buffer" :commands ("eval-buffer") :rule :r1 :lane "W3-7b" :entry "mx" :state "default" :outcome "eval-buffer runs from M-x" :observe (:screen_text) :scenario "macros/eval-buffer"))
