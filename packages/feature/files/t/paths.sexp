 (:id "r3:save-buffer:split-window" :commands (:save-buffer) :rule :r3 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "split-window" :outcome "both views reflect the change" :observe (:screen_text) :scenario "command-path/r3/save-buffer/split-window" :lane "W3-3")
 (:id "r3:save-buffer:macro-replay" :commands (:save-buffer) :rule :r3 :entry "macro" :state "macro-recording" :outcome "replay has the same effect" :observe (:file_bytes) :scenario "command-path/r3/save-buffer/macro-replay" :lane "W3-3")
 (:id "r3:save-buffer:prefix-u4" :commands (:save-buffer) :rule :r3 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "prefix-C-u-4" :outcome "specified prefix behavior is observed" :observe (:file_bytes) :scenario "command-path/r3/save-buffer/prefix-u4" :lane "W3-3")
 (:id "r3:revert-buffer:effect" :commands (:revert-buffer) :rule :r3 :entry "mx" :state "editable-buffer" :outcome "buffer changes" :observe (:file_bytes) :scenario "command-path/r3/revert-buffer/effect" :lane "W3-3")
 (:id "r3:revert-buffer:undo" :commands (:revert-buffer) :rule :r3 :entry "mx" :state "after-one-change" :outcome "original bytes restored" :observe (:file_bytes) :scenario "command-path/r3/revert-buffer/undo" :lane "W3-3")
 (:id "r3:revert-buffer:read-only" :commands (:revert-buffer) :rule :r3 :entry "mx" :state "read-only-buffer" :outcome "rejected without byte changes" :observe (:file_bytes) :scenario "command-path/r3/revert-buffer/read-only" :lane "W3-3")
 (:id "r3:revert-buffer:narrow" :commands (:revert-buffer) :rule :r3 :entry "mx" :state "narrowed-buffer" :outcome "outside range remains unchanged" :observe (:file_bytes) :scenario "command-path/r3/revert-buffer/narrow" :lane "W3-3")
 (:id "r3:revert-buffer:split-window" :commands (:revert-buffer) :rule :r3 :entry "mx" :state "split-window" :outcome "both views reflect the change" :observe (:screen_text) :scenario "command-path/r3/revert-buffer/split-window" :lane "W3-3")
 (:id "r3:revert-buffer:macro-replay" :commands (:revert-buffer) :rule :r3 :entry "macro" :state "macro-recording" :outcome "replay has the same effect" :observe (:file_bytes) :scenario "command-path/r3/revert-buffer/macro-replay" :lane "W3-3")
 (:id "r3:revert-buffer:prefix-u4" :commands (:revert-buffer) :rule :r3 :entry "mx" :state "prefix-C-u-4" :outcome "specified prefix behavior is observed" :observe (:file_bytes) :scenario "command-path/r3/revert-buffer/prefix-u4" :lane "W3-3"))
