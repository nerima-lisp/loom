 (:id "r2:write-file:prompt-1:free-string:tab" :commands (:write-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"w\",\"modifiers\":[\"control\"]}]};prompt:1:free-string" :state "an unchanged file is open; the prompted target is isolated" :outcome "presses Tab and checks the exact resulting prompt input" :observe (:screen_text) :scenario "command-path/r2/write-file/prompt-1/free-string/tab" :lane "W3-3")
