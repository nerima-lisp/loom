((:id "r1:save-buffer:key:%7B%22keymap%22%3A%22global%22%2C%22sequence%22%3A%5B%7B%22key%22%3A%22x%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%2C%7B%22key%22%3A%22s%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%5D%7D"
  :commands (:save-buffer)
  :rule :r1
  :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}"
  :state "default"
  :outcome "command runs from its key sequence"
  :observe (:file_bytes)
  :scenario "file and buffer commands"
  :lane "W3-3")
 (:id "r1:find-file:key:%7B%22keymap%22%3A%22global%22%2C%22sequence%22%3A%5B%7B%22key%22%3A%22x%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%2C%7B%22key%22%3A%22f%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%5D%7D"
  :commands (:find-file :switch-to-buffer :save-buffer :save-buffers-kill-terminal)
  :rule :r1
  :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"f\",\"modifiers\":[\"control\"]}]}"
  :state "same.txt in left/ edited; same.txt exists in right/"
  :outcome "reopening focuses the left buffer and right file is named same.txt<right>"
  :observe (:screen_text :buffer_name :buffer_path :file_bytes)
  :scenario "find-file buffer reuse and names"
  :lane "W3-3")
 (:id "r1:save-buffer:mx" :commands (:save-buffer) :rule :r1 :entry "mx" :state "BOM, mixed CRLF/LF, and invalid-byte file at point zero" :outcome "M-x save-buffer preserves the BOM, invalid byte, and each original line ending after a leading ASCII insertion" :observe (:screen_text :file_bytes) :scenario "files/file-format-preservation" :lane "W3-3")
 (:id "r1:revert-buffer:mx" :commands (:revert-buffer) :rule :r1 :entry "mx" :state "locally modified file differs from an external replacement" :outcome "M-x revert-buffer confirms discard and displays the exact external file contents" :observe (:screen_text :file_bytes) :scenario "files/external-file-change-revert" :lane "W3-3")
 (:id "r5:save-buffer:shell:success" :commands (:save-buffer) :rule :r5 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "tool:shell" :outcome "success" :observe (:external_state) :scenario "files/save-buffer-shell-success" :lane "W3-3")
 (:id "r5:save-buffer:shell:missing" :commands (:save-buffer) :rule :r5 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "tool:shell" :outcome "missing" :observe (:external_state) :scenario "files/save-buffer-shell-missing" :lane "W3-3")
 (:id "r5:save-buffer:shell:nonzero" :commands (:save-buffer) :rule :r5 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "tool:shell" :outcome "nonzero" :observe (:external_state) :scenario "files/save-buffer-shell-nonzero" :lane "W3-3")
 (:id "r5:save-buffer:shell:interrupted" :commands (:save-buffer) :rule :r5 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "tool:shell" :outcome "interrupted" :observe (:external_state) :scenario "files/save-buffer-shell-interrupted" :lane "W3-3")
 (:id "r1:find-file:mx" :commands (:find-file) :rule :r1 :entry "mx" :state "an unchanged file is open" :outcome "M-x find-file opens the Find file prompt without changing file bytes" :observe (:screen_text :file_bytes :cursor) :scenario "command-path/r1/find-file/mx" :lane "W3-3")
 (:id "r1:recent-file:key:%7B%22keymap%22%3A%22global%22%2C%22sequence%22%3A%5B%7B%22key%22%3A%22x%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%2C%7B%22key%22%3A%22r%22%2C%22modifiers%22%3A%5B%5D%7D%2C%7B%22key%22%3A%22f%22%2C%22modifiers%22%3A%5B%5D%7D%5D%7D" :commands (:recent-file) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"r\",\"modifiers\":[]},{\"key\":\"f\",\"modifiers\":[]}]}" :state "an unchanged file is open" :outcome "C-x r f opens the Recent file prompt without changing file bytes" :observe (:screen_text :file_bytes :cursor) :scenario "command-path/r1/recent-file/key" :lane "W3-3")
 (:id "r1:recent-file:mx" :commands (:recent-file) :rule :r1 :entry "mx" :state "an unchanged file is open" :outcome "M-x recent-file opens the Recent file prompt without changing file bytes" :observe (:screen_text :file_bytes :cursor) :scenario "command-path/r1/recent-file/mx" :lane "W3-3")
 (:id "r1:write-file:key:%7B%22keymap%22%3A%22global%22%2C%22sequence%22%3A%5B%7B%22key%22%3A%22x%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%2C%7B%22key%22%3A%22w%22%2C%22modifiers%22%3A%5B%22control%22%5D%7D%5D%7D" :commands (:write-file) :rule :r1 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"w\",\"modifiers\":[\"control\"]}]}" :state "an unchanged file is open" :outcome "C-x C-w opens the Write file prompt without changing file bytes" :observe (:screen_text :file_bytes :cursor) :scenario "command-path/r1/write-file/key" :lane "W3-3")
 (:id "r1:write-file:mx" :commands (:write-file) :rule :r1 :entry "mx" :state "an unchanged file is open" :outcome "M-x write-file opens the Write file prompt without changing file bytes" :observe (:screen_text :file_bytes :cursor) :scenario "command-path/r1/write-file/mx" :lane "W3-3")
 (:id "r3:save-buffer:effect" :commands (:save-buffer) :rule :r3 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"s\",\"modifiers\":[\"control\"]}]}" :state "a leading X is inserted into the buffer before C-x C-s" :outcome "save-buffer writes the exact modified bytes without moving point" :observe (:screen_text :file_bytes :cursor) :scenario "command-path/r3/save-buffer/effect" :lane "W3-3")
 (:id "r2:find-file:prompt-1:free-string:accept" :commands (:find-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"f\",\"modifiers\":[\"control\"]}]};prompt:1:free-string" :state "a file is open in the initial buffer" :outcome "accepts the exact prompt input and checks the resulting state" :observe (:screen_text) :scenario "command-path/r2/find-file/prompt-1/free-string/accept" :lane "W3-3")
 (:id "r2:find-file:prompt-1:free-string:cancel" :commands (:find-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"f\",\"modifiers\":[\"control\"]}]};prompt:1:free-string" :state "a file is open in the initial buffer" :outcome "cancels the active prompt and checks the unchanged file state" :observe (:screen_text) :scenario "command-path/r2/find-file/prompt-1/free-string/cancel" :lane "W3-3")
 (:id "r2:find-file:prompt-1:free-string:tab" :commands (:find-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"f\",\"modifiers\":[\"control\"]}]};prompt:1:free-string" :state "a file is open in the initial buffer" :outcome "presses Tab and checks the exact resulting prompt input" :observe (:screen_text) :scenario "command-path/r2/find-file/prompt-1/free-string/tab" :lane "W3-3")
 (:id "r2:find-file:prompt-1:free-string:history" :commands (:find-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"f\",\"modifiers\":[\"control\"]}]};prompt:1:free-string" :state "a file is open in the initial buffer" :outcome "recalls the exact prior prompt input and checks the result" :observe (:screen_text) :scenario "command-path/r2/find-file/prompt-1/free-string/history" :lane "W3-3")
 (:id "r2:recent-file:prompt-1:completion:accept" :commands (:recent-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"r\",\"modifiers\":[]},{\"key\":\"f\",\"modifiers\":[]}]};prompt:1:completion" :state "the startup file is in the recent-file list" :outcome "accepts the exact prompt input and checks the resulting state" :observe (:screen_text) :scenario "command-path/r2/recent-file/prompt-1/completion/accept" :lane "W3-3")
 (:id "r2:recent-file:prompt-1:completion:cancel" :commands (:recent-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"r\",\"modifiers\":[]},{\"key\":\"f\",\"modifiers\":[]}]};prompt:1:completion" :state "the startup file is in the recent-file list" :outcome "cancels the active prompt and checks the unchanged file state" :observe (:screen_text) :scenario "command-path/r2/recent-file/prompt-1/completion/cancel" :lane "W3-3")
 (:id "r2:recent-file:prompt-1:completion:empty" :commands (:recent-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"r\",\"modifiers\":[]},{\"key\":\"f\",\"modifiers\":[]}]};prompt:1:completion" :state "the startup file is in the recent-file list" :outcome "submits empty input and checks the command response" :observe (:screen_text) :scenario "command-path/r2/recent-file/prompt-1/completion/empty" :lane "W3-3")
 (:id "r2:recent-file:prompt-1:completion:tab" :commands (:recent-file) :rule :r2 :entry "key:{\"keymap\":\"global\",\"sequence\":[{\"key\":\"x\",\"modifiers\":[\"control\"]},{\"key\":\"r\",\"modifiers\":[]},{\"key\":\"f\",\"modifiers\":[]}]};prompt:1:completion" :state "the startup file is in the recent-file list" :outcome "presses Tab and checks the exact resulting prompt input" :observe (:screen_text) :scenario "command-path/r2/recent-file/prompt-1/completion/tab" :lane "W3-3")
