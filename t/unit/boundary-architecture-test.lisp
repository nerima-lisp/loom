(in-package #:loom/test)
(defun boundary-safe-readtable ()
  (let ((readtable (copy-readtable nil)))
    (set-dispatch-macro-character
     #\# #\.
     (lambda (stream sub-character numeric-argument)
       (declare (ignore sub-character numeric-argument))
       (read stream t nil t))
     readtable)
    readtable))

